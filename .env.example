# Copie para .env.local (ignorado pelo git) e preencha com os valores do seu
# projeto Supabase: Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Evolution API (integração real de WhatsApp) — ver setup-evolution-nodejs.ps1.
# Sem prefixo VITE_ de propósito: fica só no servidor, nunca no navegador.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
